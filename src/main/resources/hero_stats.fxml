<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="heroStatsPanel" prefWidth="230.0" maxHeight="-Infinity" spacing="15.0" styleClass="ink-panel" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpgc.rpg131023.view.HeroStatsController">
    <children>
        <Label styleClass="ink-title" text="HERO STATS" />
        <Region minHeight="2.0" styleClass="ink-separator" />
        <VBox spacing="8.0">
            <children>
                <HBox spacing="5.0">
                    <Label styleClass="ink-stat-key" text="Level:" />
                    <Label fx:id="lblHeroLevel" styleClass="ink-stat-val" text="1" />
                </HBox>
                <HBox spacing="5.0">
                    <Label styleClass="ink-stat-key" text="XP:" />
                    <Label fx:id="lblHeroXp" styleClass="ink-stat-val" text="0/100" />
                </HBox>
                <HBox spacing="5.0">
                    <Label styleClass="ink-stat-key" text="Health:" />
                    <Label fx:id="lblHeroHealth" styleClass="ink-stat-val" text="100/100" />
                </HBox>
                <HBox spacing="5.0">
                    <Label styleClass="ink-stat-key" text="Armor:" />
                    <Label fx:id="lblHeroArmor" styleClass="ink-stat-val" text="0" />
                </HBox>
                <HBox spacing="5.0">
                    <Label styleClass="ink-stat-key" text="Hunger:" />
                    <Label fx:id="lblHeroHunger" styleClass="ink-stat-val" text="0" />
                </HBox>
                <HBox fx:id="boxSword" spacing="5.0">
                    <Label styleClass="ink-stat-key" text="Sword:" />
                    <Label fx:id="lblHeroSword" styleClass="ink-stat-val" text="NO" />
                    <ProgressBar fx:id="barSwordDurability" prefHeight="10.0" prefWidth="50.0" progress="0.0" />
                </HBox>
                <HBox spacing="5.0">
                    <Label styleClass="ink-stat-key" text="Total Damage:" />
                    <Label fx:id="lblHeroDamage" styleClass="ink-stat-val" text="20" />
                </HBox>
            </children>
        </VBox>
        <Region minHeight="2.0" styleClass="ink-separator" />
        <VBox fx:id="invBox" spacing="5.0">
            <children>
                <Label styleClass="ink-stat-key" text="INVENTORY" />
            </children>
        </VBox>
        <Region minHeight="2.0" styleClass="ink-separator" />
        <GridPane alignment="CENTER" hgap="10.0" vgap="10.0">
            <children>
                <Button fx:id="btnPotion" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handlePotion" styleClass="ink-button" text="POTION" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Button fx:id="btnFood" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleFood" styleClass="ink-button" text="FOOD" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Button fx:id="btnSword" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSword" styleClass="ink-button" text="SWORD" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Button fx:id="btnArmor" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleArmor" styleClass="ink-button" text="ARMOR" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </children>
        </GridPane>
    </children>
</VBox>
